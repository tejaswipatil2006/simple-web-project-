# =======================================================
# Smart Notes AI Assistant - Environment Variables
# =======================================================

# 1. Google Gemini API Key (Get from: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Flask Secret Key (A random string for signing user sessions)
SECRET_KEY=smart_notes_ai_assistant_secret_key_change_me_in_production

# 3. Firebase Admin Service Account JSON File Path (Default: firebase/serviceAccountKey.json)
FIREBASE_SERVICE_ACCOUNT_PATH=firebase/serviceAccountKey.json

# 4. Optional: Flask Environment (development / production)
FLASK_ENV=development
